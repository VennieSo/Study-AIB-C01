---
import ExamFaq from '../components/ExamFaq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../content/site';
import { homeStructuredData } from '../content/structured-data';
import { examPresets, examAvailability } from '../lib/exam-session';
import { domains } from '../lib/exam-scope';
import { practiceQuestions, practiceSizes } from '../lib/questions';
import { loadSiteBank } from '../data/load-bank';
import '../styles/global.css';

const { questions, synthetic } = await loadSiteBank();
const availability = domains.map((domain) => ({ ...domain, count: practiceQuestions(questions, domain.id).length }));
const initialDomain = availability.find((domain) => domain.count >= 10) ?? availability[0]!;
const payload = JSON.stringify(questions).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={site.title} description={site.description} path="/" socialTitle={site.socialTitle} socialDescription={site.socialDescription} noindex={synthetic} structuredData={synthetic ? undefined : homeStructuredData} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader home />
    <main id="main" class="wrap">
      {synthetic && <p class="preview-notice">Development preview · synthetic questions</p>}
      <div id="home-view">
        <section class="hero" aria-labelledby="home-heading">
          <div class="hero-copy">
            <h1 id="home-heading">{site.heading}</h1>
            <p class="hero-subheading">{site.subheading}</p>
            <p class="intro">{site.introduction}</p>
            <div class="feature-line">{site.features.map((feature) => <span>{feature}</span>)}</div>
          </div>
        </section>
        <section class="setup-panel" id="configure" aria-labelledby="configuration-heading">
          <div class="setup-copy">
            <h2 id="configuration-heading" tabindex="-1">Practice Questions</h2>
            <p class="muted">Choose one domain or explore them all. Untimed, with instant explanations.</p>
            <div class="session-details"><div><span class="field-label">Session length</span><strong>10–30 questions</strong></div><div><span class="field-label">Time limit</span><strong>None</strong></div></div>
          </div>
          <div class="setup-controls">
            <form id="configuration-form">
              <label class="field-label" for="domain">Choose a domain</label>
              <select name="domain" id="domain" aria-describedby="availability">
                {availability.map((domain) => <option value={domain.id} selected={domain.id === initialDomain.id}>{domain.number}. {domain.name}</option>)}
                <option value="all">All domains (mixed)</option>
              </select>
              <label class="field-label count-label" for="question-count">Question count</label>
              <select name="question-count" id="question-count" aria-describedby="availability">
                {practiceSizes.map((count) => <option value={count} disabled={initialDomain.count < count}>{count} questions</option>)}
              </select>
              <p id="availability" class="field-note" aria-live="polite">{initialDomain.count >= 10 ? `${initialDomain.count} questions available. 10 will be sampled.` : `${initialDomain.count} questions available. This scope needs at least 10 questions.`}</p>
              <p class="lifetime">{site.lifetime}</p>
              <button type="submit" id="start-button" class="button primary" disabled>Start practice <span aria-hidden="true">→</span></button>
              <p id="configuration-error" class="error" role="alert"></p>
            </form>
            <noscript><p class="error">JavaScript is required to start a practice session. You can still explore the domain information and official exam guide.</p></noscript>
          </div>
        </section>
        <section class="setup-panel" id="exam-config" aria-labelledby="exam-configuration-heading">
          <div class="setup-copy">
            <h2 id="exam-configuration-heading" tabindex="-1">Timed Exam</h2>
            <p class="muted">Practice across all domains under time pressure. Revise or skip answers until you submit.</p>
            <div class="session-details"><div><span class="field-label">Session length</span><strong>40 min to full exam length</strong></div></div>
          </div>
          <div class="setup-controls">
            <form id="exam-configuration-form">
              <label class="field-label" for="exam-preset">Exam length</label>
              <select id="exam-preset" name="exam-preset">
                {examPresets.map((preset) => <option value={preset.questionCount} selected={preset.questionCount === 85} disabled={!examAvailability(questions, preset.questionCount).available}>{preset.questionCount} questions / {preset.durationMinutes} minutes{preset.label ? ` (${preset.label})` : ''}</option>)}
              </select>
              <p id="exam-availability" class="field-note" aria-live="polite"></p>
              <p class="lifetime">{site.lifetime} The timer continues while this tab is inactive or your device sleeps.</p>
              <button type="submit" id="start-exam" class="button primary" disabled>Start exam <span aria-hidden="true">→</span></button>
              <p id="exam-configuration-error" class="error" role="alert"></p>
            </form>
          </div>
        </section>
        <section class="domains-section" aria-labelledby="domains-heading">
          <div class="section-heading"><div><p class="eyebrow">The bigger picture</p><h2 id="domains-heading">Four domains. One business perspective.</h2></div><p class="muted">Aligned with the official exam scope.</p></div>
          <div class="domain-grid">
            {availability.map((domain) => <article class="domain-card"><div class="domain-card-top"><span class="domain-number">0{domain.number}</span><span class="weight">{domain.weight}% of exam</span></div><h3>{domain.name}</h3><p>{domain.description}</p><span class="domain-availability">{domain.count} questions available</span><a class="domain-link" href={`${site.factsPath}#domains`} aria-label={`What ${domain.name} covers`}>What this domain covers <span aria-hidden="true">→</span></a></article>)}
          </div>
        </section>
        <ExamFaq />
      </div>
      <section id="session-view" class="session-shell" aria-label="Practice session" hidden></section>
      <section id="exam-session-view" class="session-shell" aria-label="Exam session" hidden></section>
      <p id="application-error" class="error" role="alert"></p>
    </main>
    <SiteFooter analytics={!synthetic} />
    <script id="question-data" type="application/json" set:html={payload} />
    <script src="../scripts/practice.ts"></script>
    <script src="../scripts/exam.ts"></script>
  </body>
</html>

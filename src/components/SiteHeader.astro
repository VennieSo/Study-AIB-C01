---
import { site } from '../content/site';

interface Props {
  /** On the homepage the Practice and Exam links are in-page anchors with script hooks. */
  home?: boolean;
}

const { home = false } = Astro.props;
const base = home ? '' : '/';
---
<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label={`${site.name} home`}><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 5.5h5a3 3 0 0 1 3 3v11a4 4 0 0 0-3-1.25H5zM19 5.5h-3a3 3 0 0 0-3 3v11a4 4 0 0 1 3-1.25h3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg></span><span>{site.name}</span></a>
  <nav aria-label="Main navigation"><a href={`${base}#configure`} id="practice-link">Practice Questions</a><a href={`${base}#exam-config`} id="exam-link">Timed Exam</a><a href={site.factsPath} aria-current={home ? undefined : 'page'}>AIB-C01 Facts</a></nav>
  <a class="header-note" href={site.examGuideUrl}>Official exam guide <span aria-hidden="true">↗</span></a>
</header>

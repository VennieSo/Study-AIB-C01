---
import { faqItems } from '../content/faq';
---
<section class="faq" id="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading">AWS Certified AI Business Strategist (AIB-C01) FAQ</h2>
  <div class="faq-items">
    {faqItems.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <div class="answer" set:html={item.answer} />
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    margin-bottom: 72px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }
  h2 {
    margin-bottom: 24px;
    font-size: 1.5rem;
  }
  .faq-items {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  details + details {
    border-top: 1px solid var(--border);
  }
  summary {
    position: relative;
    padding: 16px 52px 16px 20px;
    cursor: pointer;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 22px;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: translateY(-65%) rotate(45deg);
  }
  details[open] > summary::after {
    transform: translateY(-30%) rotate(225deg);
  }
  summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
    border-radius: 12px;
  }
  .answer {
    padding: 0 20px 18px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .answer :global(a) {
    color: var(--ink);
  }
  .answer :global(ul) {
    margin: 8px 0;
    padding-inline-start: 22px;
  }
  @media (max-width: 768px) {
    .faq {
      margin-bottom: 48px;
      padding-top: 28px;
    }
    h2 {
      font-size: 1.375rem;
    }
    summary {
      padding-left: 16px;
    }
    .answer {
      padding-inline: 16px;
    }
  }
</style>

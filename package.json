{
  "name": "aib-c01-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:content && astro build",
    "build:fixtures": "astro build --mode fixture --outDir .qa-dist",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "validate:launch": "node --import tsx scripts/validate-content.ts --launch"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "7.4.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}

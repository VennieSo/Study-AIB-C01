{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIB-C01 initial question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://([a-z0-9-]+\\.)*aws\\.amazon\\.com/"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domainId", "taskId", "type", "text", "options", "correctOptionIds", "explanation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "domainId": { "enum": ["domain-1", "domain-2", "domain-3", "domain-4"] },
        "taskId": {
          "description": "Official AWS task ID; for example, 1.1 is Task 1.1: Describe core AI concepts and define terminology.",
          "enum": ["1.1", "1.2", "1.3", "2.1", "2.2", "2.3", "3.1", "3.2", "3.3", "4.1", "4.2", "4.3", "4.4"]
        },
        "topic": { "type": "string", "minLength": 1 },
        "type": { "enum": ["single", "multiple"] },
        "text": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "correctOptionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      },
      "allOf": [
        {
          "if": { "properties": { "domainId": { "const": "domain-1" } } },
          "then": { "properties": { "taskId": { "enum": ["1.1", "1.2", "1.3"] } } }
        },
        {
          "if": { "properties": { "domainId": { "const": "domain-2" } } },
          "then": { "properties": { "taskId": { "enum": ["2.1", "2.2", "2.3"] } } }
        },
        {
          "if": { "properties": { "domainId": { "const": "domain-3" } } },
          "then": { "properties": { "taskId": { "enum": ["3.1", "3.2", "3.3"] } } }
        },
        {
          "if": { "properties": { "domainId": { "const": "domain-4" } } },
          "then": { "properties": { "taskId": { "enum": ["4.1", "4.2", "4.3", "4.4"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "single" } } },
          "then": {
            "properties": {
              "options": { "minItems": 4, "maxItems": 4 },
              "correctOptionIds": { "minItems": 1, "maxItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "multiple" } } },
          "then": {
            "properties": {
              "options": { "minItems": 5 },
              "correctOptionIds": { "minItems": 2 }
            }
          }
        }
      ]
    }
  }
}
